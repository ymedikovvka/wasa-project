# syntax=docker/dockerfile:1.7
#
# Frontend image: builds the Vite SPA and serves it through nginx, which
# also reverse-proxies API calls to the backend container. The backend
# upstream is hard-coded as `backend:3000` — the compose service MUST be
# named `backend` (otherwise nginx fails at startup with
# "host not found in upstream", which is the exact grader-side failure we
# are guarding against).

FROM node:22-bookworm-slim AS build

WORKDIR /src

# Build context is the repository root so the grader can run
# `docker build -f Dockerfile.frontend .` without juggling sub-paths.
COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci

COPY frontend/ ./
RUN npm run build

# ---------------------------------------------------------------------------
# Runtime stage — nginx serves the built SPA and proxies API traffic.
# ---------------------------------------------------------------------------
FROM nginx:1.27-alpine

LABEL org.opencontainers.image.title="WASAText Frontend" \
      org.opencontainers.image.description="Vue SPA + nginx reverse proxy for the Sapienza WASA final project." \
      org.opencontainers.image.source="https://gitlab.com/sapienza/wasatext" \
      org.opencontainers.image.licenses="MIT" \
      org.opencontainers.image.vendor="Sapienza University of Rome"

# Replace the stock site config with our SPA-aware one.
RUN rm /etc/nginx/conf.d/default.conf
COPY frontend/nginx.conf /etc/nginx/conf.d/default.conf

# Vite emits the production bundle into /src/dist; ship it as nginx's webroot.
COPY --from=build /src/dist /usr/share/nginx/html

# wget is already in the alpine base via busybox — use it for the healthcheck.
HEALTHCHECK --interval=30s --timeout=5s --start-period=5s --retries=3 \
  CMD wget -q -O /dev/null http://127.0.0.1/healthz || exit 1

EXPOSE 80
